rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (("phone_number" in request.auth.token
        && request.auth.token.phone_number == "+254719241166")
        || ("email" in request.auth.token
        && request.auth.token.email == "toniekimanie@gmail.com"
        && request.auth.token.email_verified == true));
    }

    function isVerifiedCustomer() {
      return request.auth != null
        && (("phone_number" in request.auth.token
        && request.auth.token.phone_number != null)
        || ("email" in request.auth.token
        && request.auth.token.email_verified == true));
    }

    match /inquiries/{inquiryId} {
      allow create: if isVerifiedCustomer()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "New";

      allow read: if isAdmin()
        || (isVerifiedCustomer()
        && resource.data.userId == request.auth.uid);

      allow update: if isAdmin();

      allow delete: if false;
    }
  }
}
