rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.phone_number == "+254719241166";
    }

    match /sourcing-orders/{userId}/{fileName} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /testimonial-photos/{userId}/{testimonialId}/{fileName} {
      function publishedPhoto() {
        return firestore.exists(/databases/(default)/documents/testimonials/$(testimonialId))
          && firestore.get(/databases/(default)/documents/testimonials/$(testimonialId)).data.published == true
          && firestore.get(/databases/(default)/documents/testimonials/$(testimonialId)).data.photoPath
            == 'testimonial-photos/' + userId + '/' + testimonialId + '/' + fileName;
      }

      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId)
        || publishedPhoto();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
