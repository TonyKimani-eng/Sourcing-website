rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.phone_number == "+254719241166";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function validInquiry(data) {
      return data.keys().hasAll([
          "requestType", "productName", "productCategory", "userId",
          "customerName", "customerPhone", "customerEmail", "status",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "requestType", "productName", "productCategory", "description",
          "contactMethod", "photoUrls", "storage", "color", "priceEstimate",
          "quantity", "paymentMethod", "paymentStatus", "paymentNote",
          "paymentCode", "orderItems", "userId", "customerName",
          "customerPhone", "customerEmail", "status", "createdAt", "updatedAt"
        ])
        && data.requestType in ["product", "sourcing"]
        && data.productName is string
        && data.productName.size() > 0
        && data.productName.size() <= 160
        && data.productCategory is string
        && data.productCategory.size() > 0
        && data.productCategory.size() <= 100
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 100
        && data.customerPhone is string
        && data.customerPhone.size() <= 40
        && data.customerEmail is string
        && data.customerEmail.size() <= 254
        && (!data.keys().hasAny(["description"])
          || (data.description is string && data.description.size() <= 2000))
        && (!data.keys().hasAny(["contactMethod"])
          || (data.contactMethod is string && data.contactMethod.size() <= 160))
        && (!data.keys().hasAny(["photoUrls"])
          || (data.photoUrls is list && data.photoUrls.size() <= 4))
        && (!data.keys().hasAny(["storage"])
          || (data.storage is string && data.storage.size() <= 80))
        && (!data.keys().hasAny(["color"])
          || (data.color is string && data.color.size() <= 80))
        && (!data.keys().hasAny(["priceEstimate"])
          || (data.priceEstimate is number && data.priceEstimate >= 0))
        && (!data.keys().hasAny(["quantity"])
          || (data.quantity is int && data.quantity > 0 && data.quantity <= 100))
        && (!data.keys().hasAny(["paymentCode"])
          || (data.paymentCode is string && data.paymentCode.size() <= 80))
        && (!data.keys().hasAny(["paymentMethod"])
          || (data.paymentMethod is string && data.paymentMethod.size() <= 80))
        && (!data.keys().hasAny(["paymentStatus"])
          || (data.paymentStatus is string && data.paymentStatus.size() <= 120))
        && (!data.keys().hasAny(["paymentNote"])
          || (data.paymentNote is string && data.paymentNote.size() <= 500))
        && (!data.keys().hasAny(["orderItems"])
          || (data.orderItems is list && data.orderItems.size() <= 20))
        && data.status == "New";
    }

    match /inquiries/{inquiryId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validInquiry(request.resource.data);

      allow read: if isAdmin()
        || (request.auth != null
        && resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
        || (isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == "Delivered"
        && request.resource.data.status == "Received"
        && request.resource.data.customerConfirmedReceived == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "customerConfirmedReceived", "customerReceivedAt", "updatedAt"]));

      allow delete: if false;
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.published == true
        || isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && testimonialId == request.resource.data.inquiryId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.published == true
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.reviewerName is string
        && request.resource.data.reviewerName.size() > 0
        && request.resource.data.reviewerName.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 600
        && request.resource.data.orderLabel is string
        && request.resource.data.orderLabel.size() > 0
        && request.resource.data.orderLabel.size() <= 80
        && ((!('photoUrl' in request.resource.data) && !('photoPath' in request.resource.data))
          || (request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() > 0
          && request.resource.data.photoUrl.size() <= 2048
          && request.resource.data.photoPath is string
          && request.resource.data.photoPath.matches('testimonial-photos/' + request.auth.uid + '/' + testimonialId + '/[^/]+')))
        && request.resource.data.keys().hasOnly([
          "inquiryId", "userId", "reviewerName", "rating", "message",
          "orderLabel", "published", "createdAt", "updatedAt", "photoUrl", "photoPath"
        ])
        && get(/databases/$(database)/documents/inquiries/$(testimonialId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/inquiries/$(testimonialId)).data.status == "Received";

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow create: if isSignedIn()
        && request.auth.uid == chatId
        && request.resource.data.visitorUid == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.visitorName is string
        && request.resource.data.visitorName.size() > 0
        && request.resource.data.visitorName.size() <= 80
        && request.resource.data.visitorContact is string
        && request.resource.data.visitorContact.size() > 0
        && request.resource.data.visitorContact.size() <= 120
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastSender == "visitor"
        && request.resource.data.unreadByAdmin == 1
        && request.resource.data.keys().hasOnly([
          "visitorUid", "visitorName", "visitorContact", "lastMessage",
          "lastSender", "unreadByAdmin", "status", "createdAt", "updatedAt"
        ]);

      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == chatId);

      allow update: if isAdmin()
        || (isSignedIn()
        && request.auth.uid == chatId
        && resource.data.visitorUid == request.auth.uid
        && request.resource.data.visitorUid == request.auth.uid
        && request.resource.data.lastSender == "visitor"
        && request.resource.data.status == "open"
        && request.resource.data.unreadByAdmin == 1
        && request.resource.data.visitorName is string
        && request.resource.data.visitorName.size() > 0
        && request.resource.data.visitorName.size() <= 80
        && request.resource.data.visitorContact is string
        && request.resource.data.visitorContact.size() > 0
        && request.resource.data.visitorContact.size() <= 120
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "visitorName", "visitorContact", "lastMessage", "lastSender",
          "unreadByAdmin", "status", "createdAt", "updatedAt"
        ]));

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid == chatId);

        allow create: if (isAdmin()
          && request.resource.data.sender == "admin"
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(["sender", "text", "createdAt"]))
          || (isSignedIn()
          && request.auth.uid == chatId
          && request.resource.data.sender == "visitor"
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(["sender", "text", "createdAt"]));

        allow update, delete: if false;
      }
    }
  }
}
